# Generated by `preview.py catalog` from the local JianYing install — 14 MB, reproducible.
assets/generated/

# Local scratch: throwaway probes and pre-refactor snapshots.
temp/
test/

# Test fixtures: a copied JianYing draft (hundreds of MB, private media references) and the
# real export it gets compared against. Both live outside the repo — the draft copy sits in
# the corpus, the export under the user state dir — and must never be staged from wherever
# they happen to land. See docs/handoff/2026-10-13-export-match-fixture.md.
fixtures/
*jianying-draft-fixture*/
*1012-1626-fixture/

# Python.
__pycache__/
*.py[cod]

# Virtualenvs: the isolated GStreamer runtime measured 370 MB, so it must never be
# stageable from wherever it gets rebuilt — `temp/` covered it only by accident of location.
.venv/
venv/

# Node: web/package.json is tracked (it declares the ESM the web modules need), so an
# accidental `npm install` in that directory would otherwise show up as new source.
node_modules/

# Tool state that is not part of the skill.
.workbuddy/
.codegraph/
.pi/
nul
scripts/jypreview/native/bin/
scripts/jypreview/native/obj/
